# ==========================================
# Agent WAF - Environment Configuration
# ==========================================

# Server Configuration
PORT=4000
NODE_ENV=development

# Database Configuration (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/agentwaf?schema=public

# Cache Configuration (Redis)
REDIS_URL=redis://localhost:6379

# Authentication (Better Auth)
# Generate a random 32-character string for production
BETTER_AUTH_SECRET=agent_waf_super_secret_session_key_32_chars_long_demo
BETTER_AUTH_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

# AI Configuration (Gemini)
# Get your API key from Google AI Studio
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Default Admin Credentials (seeded on first run)
ADMIN_DEFAULT_PASSWORD=ChangeMe123!
